# Platform JWT Authentication
# Shared secret for JWT validation (must match platform database)
PLATFORM_SERVICE_TOKEN=your-shared-secret-here

# Platform API Configuration
# URL of the platform API for user API key resolution
PLATFORM_URL=https://your-platform.com

# Server Configuration
# Port for the server to listen on
PORT=8080

# Node environment
NODE_ENV=development

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# CORS Configuration
# Allowed origin for CORS requests
CORS_ORIGIN=https://agentbase.me
